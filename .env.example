NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — bypassa RLS, só usada no servidor (nunca no browser)
# para operações que precisam de aceder a dados de outros utilizadores,
# como enviar notificações push. Supabase → Project Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# DSN do Sentry (monitorização de erros) — sentry.io → projecto → Settings.
NEXT_PUBLIC_SENTRY_DSN=

# Chaves VAPID para Web Push — gerar com `npx web-push generate-vapid-keys`
# A pública tem de ser NEXT_PUBLIC_ porque é usada no browser para subscrever.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:exemplo@ride2gether.pt
